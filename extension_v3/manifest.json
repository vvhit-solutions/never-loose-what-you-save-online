{
    "manifest_version": 3,
    "name": "Never Lose What You Save Online",
    "version": "1.0.0",
    "description": "Never lose what you save online. One-click smart save with AI tagging.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "bookmarks",
        "identity"
    ],
    "host_permissions": [
        "https://cafgyalmjsfvsymuldml.supabase.co/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "scripts/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scripts/content.js"
            ]
        }
    ]
}