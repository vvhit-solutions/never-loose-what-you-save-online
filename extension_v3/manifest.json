{
    "manifest_version": 3,
    "name": "Never Lose Again - Internet Memory",
    "version": "1.0.0",
    "description": "Never lose what you save online again. One-click smart save with AI tagging.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "bookmarks"
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "scripts/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scripts/content.js"
            ]
        }
    ]
}